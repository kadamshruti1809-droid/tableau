      <aliases enabled='yes' />
      <column caption='Review Performance Score ' datatype='integer' name='[Calculation_1733155095617536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Pricing Category' datatype='string' name='[Calculation_1733155097165826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;luxury&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;standard&quot;&#13;&#10;ELSE &quot;budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1733155099160579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number of Records]&gt;=100 THEN &quot;Highly Reviwed &quot;&#13;&#10;ELSE &quot;Less Reviwed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1733155099525124]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()THEN &quot;Active host&quot;&#13;&#10;ELSE &quot;New hist&quot; &#13;&#10;END' />
      </column>
