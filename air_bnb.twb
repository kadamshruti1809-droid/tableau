      <aliases enabled='yes' />
      <column caption='Price FIlter Category' datatype='string' name='[Calculation_0583066271698946]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 0583066270380033]&#13;&#10;THEN &quot;Above limit&quot;&#13;&#10;ELSE &quot;Below limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Bed Criteria' datatype='string' name='[Calculation_0583066274709509]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds]&gt;[Parameters].[Parameter 0583066274279428]&#13;&#10;THEN &quot;optimum number of beds&quot;&#13;&#10;ELSE &quot;not enough beds&quot;&#13;&#10;END' />
      </column>
      <column caption='hotel count' datatype='integer' name='[Calculation_0583066277826566]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='host Since_NEW' datatype='date' name='[Calculation_0583066279669767]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review Performance Score ' datatype='integer' name='[Calculation_1733155095617536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Pricing Category' datatype='string' name='[Calculation_1733155097165826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;luxury&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;standard&quot;&#13;&#10;ELSE &quot;budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1733155099160579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number of Records]&gt;=100 THEN &quot;Highly Reviwed &quot;&#13;&#10;ELSE &quot;Less Reviwed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1733155099525124]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;= TODAY()&#13;&#10;THEN &quot;Active host&quot;&#13;&#10;ELSE &quot;New hist&quot; &#13;&#10;END' />
      </column>
